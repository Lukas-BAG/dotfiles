# i3blocks config for system info bar (bottom bar)
# CPU, memory, and date — secondary info kept separate from the main status bar.

separator_block_width=15
markup=none


# --- System resources ---

[cpu]
command=$HOME/.config/i3/scripts/cpu_status.sh
color=#FE8019
min_width=CPU 100.00%
interval=2
separator=false
separator_block_width=5

[memory]
command=$HOME/.config/i3/scripts/memory_status.sh
color=#83A598
min_width=MEM 100%
interval=5


# --- Date ---

[time]
label=
command=date '+%d.%m.%Y'
color=#A89984
interval=60
