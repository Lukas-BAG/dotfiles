# i3blocks config
#
# Every block names its command explicitly; scripts live in ~/.config/i3/scripts.
separator_block_width=15
markup=none


# --- System info hint (Win+i to show notification) ---

[sysinfo-hint]
command=echo " Win+i"
markup=none
interval=once
color=#928374


# --- Clock ---

[time]
label=
command=date '+%H:%M'
color=#EBDBB2
interval=5


# --- Audio ---

[volume]
command=$HOME/.config/i3/scripts/volume_status.sh
markup=pango
interval=persist
color=#B8BB26


# --- Power (hidden gracefully when no battery present) ---

[battery]
command=$HOME/.config/i3/scripts/battery_status.sh
markup=pango
interval=2


