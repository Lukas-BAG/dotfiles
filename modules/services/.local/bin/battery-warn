#!/usr/bin/env bash
# Low-battery warnings via desktop notifications. Run every minute by
# battery-warn.timer (see ~/.config/systemd/user/).
#
# - On battery, crossing BATTERY_WARN_LOW (15%) sends one normal notification.
# - Crossing BATTERY_WARN_CRITICAL (5%) sends a critical one, repeated every
#   BATTERY_WARN_REPEAT seconds (180) while still discharging.
# - Plugging in the charger resets both, so they fire again next time.
# - No battery (no BAT* in the power_supply dir): exit quietly.
#
# Reads sysfs directly, so it doesn't need `acpi`. Override the settings via
# the environment, e.g. `systemctl --user edit battery-warn.service`.

low=${BATTERY_WARN_LOW:-15}
critical=${BATTERY_WARN_CRITICAL:-5}
repeat=${BATTERY_WARN_REPEAT:-180}
supply_dir=${BATTERY_WARN_SUPPLY_DIR:-/sys/class/power_supply}
state_file=${BATTERY_WARN_STATE:-${XDG_RUNTIME_DIR:-/tmp}/battery-warn.state}

shopt -s nullglob
batteries=("$supply_dir"/BAT*)
[[ ${#batteries[@]} -eq 0 ]] && exit 0

# Average capacity over all batteries; discharging if any battery is.
total=0 count=0 discharging=0
for bat in "${batteries[@]}"; do
    read -r cap < "$bat/capacity" 2>/dev/null || continue
    read -r status < "$bat/status" 2>/dev/null
    total=$((total + cap)) count=$((count + 1))
    [[ $status == Discharging ]] && discharging=1
done
[[ $count -eq 0 ]] && exit 0
capacity=$((total / count))

if [[ $discharging -eq 0 ]]; then
    rm -f "$state_file"
    exit 0
fi

# State file: "<level> <epoch of last notification>", level is low|critical.
level=none last=0
[[ -r $state_file ]] && read -r level last < "$state_file"
now=$(date +%s)

notify() {
    notify-send -u "$1" -a battery-warn -i battery-caution \
        -h string:x-dunst-stack-tag:battery-warn "$2" "$3"
}

if (( capacity <= critical )); then
    if [[ $level != critical ]] || (( now - last >= repeat )); then
        notify critical "Battery critical: ${capacity}%" "Plug in the charger now."
        echo "critical $now" > "$state_file"
    fi
elif (( capacity <= low )); then
    if [[ $level == none ]]; then
        notify normal "Battery low: ${capacity}%" "Consider plugging in the charger."
        echo "low $now" > "$state_file"
    fi
fi
